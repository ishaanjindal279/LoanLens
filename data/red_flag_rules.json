{
  "_metadata": {
    "description": "Configurable Red Flag Rules for Suspicious Loan Message and T&C Detection",
    "version": "2.0",
    "note": "Weights, patterns, and thresholds can be adjusted here without changing source code."
  },
  "risk_thresholds": {
    "HIGH": 65,
    "SUSPICIOUS": 35,
    "LOW": 0
  },
  "score_contributions": {
    "rbi_not_found": 30,
    "rbi_partial_match": 15,
    "flagged_database_match": 50,
    "ml_suspicious": 25,
    "ml_safe": -10
  },
  "rules": [
    {
      "id": "upfront_fee",
      "label": "Upfront Fee Demanded",
      "weight": 25,
      "patterns": [
        "pay.*(?:processing|registration|security|insurance|gst|service|file|disbursement).*fee",
        "(?:processing|registration|security|insurance|service|file|verification).*fee.*(?:before|prior|first|advance|upfront)",
        "deposit.*before.*(?:loan|disburs)",
        "(?:fee|payment|charge|amount).*before.*(?:receive|get|loan|disburs)",
        "advance.*(?:payment|fee|deposit|money)",
        "pay.*(?:\\u20b9|rs\\.?|inr)\\s*\\d+.*(?:before|prior|upfront|to release)",
        "transfer.*amount.*(?:first|before|advance|deposit)",
        "(?:processing fee|advance payment|file charge|security deposit).*(?:pehle|transfer karo|bhejo|jama karo)",
        "(?:\\u092a\\u094d\\u0930\\u094b\\u0938\\u0947\\u0938\\u093f\\u0902\\u0917 \\u092b\\u0940\\u0938|\\u0905\\u0917\\u094d\\u0930\\u093f\\u092e \\u0936\\u0941\\u0932\\u094d\\u0915|\\u0930\\u091c\\u093f\\u0938\\u094d\\u091f\\u094d\\u0930\\u0947\\u0938\\u093c\\u0928 \\u092b\\u0940\\u0938).*(?:\\u092a\\u0939\\u0932\\u0947|\\u091c\\u092e\\u093e|\\u092d\\u0947\\u091c\\u094b|\\u0926\\u094b)",
        "(?:\\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0ba3\\u0bae\\u0bcd|\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bae\\u0bcd).*(?:\\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1|\\u0b95\\u0bca\\u0b9f\\u0bc1)",
        "(?:\\u0c2a\\u0c4d\\u0c30\\u0c3e\\u0c38\\u0c46\\u0c38\\u0c3f\\u0c02\\u0c17\\u0c4d \\u0c2b\\u0c40\\u0c1c\\u0c41|\\u0c2e\\u0c41\\u0c02\\u0c26\\u0c41\\u0c17\\u0c3e \\u0c1a\\u0c46\\u0c32\\u0c4d\\u0c32\\u0c3f\\u0c02\\u0c1a\\u0c02\\u0c21\\u0c3f)",
        "(?:\\u0906\\u0917\\u093e\\u090a \\u092b\\u0940|\\u092a\\u094d\\u0930\\u094b\\u0938\\u0947\\u0938\\u093f\\u0902\\u0917 \\u092b\\u0940).*(?:\\u092d\\u0930\\u093e|\\u0926\\u094d\\u092f\\u093e)",
        "(?:\\u0985\\u0997\\u09cd\\u09b0\\u09bf\\u09ae \\u09ab\\u09bf|\\u09aa\\u09cd\\u09b0\\u09b8\\u09c7\\u09b8\\u09bf\\u0982 \\u09ab\\u09bf).*(?:\\u099c\\u09ae\\u09be \\u09a6\\u09bf\\u09a8)",
        "(?:\\u0cae\\u0cc1\\u0c82\\u0c97\\u0ca1 \\u0cb6\\u0cc1\\u0cb2\\u0ccd\\u0c95|\\u0cb9\\u0ca3 \\u0caa\\u0cbe\\u0cb5\\u0ca4\\u0cbf\\u0cb8\\u0cbf)"
      ],
      "explanation": "Legitimate lenders never ask for processing fees, security deposits, or file charges BEFORE disbursing the loan. Fees are always deducted from the sanctioned loan amount.",
      "recommendation": "Do not pay any upfront fee under any circumstances. Report such demands at cybercrime.gov.in"
    },
    {
      "id": "guaranteed_approval",
      "label": "Guaranteed / Instant Approval Claim",
      "weight": 15,
      "patterns": [
        "100%\\s*(?:guaranteed|assured|confirm|approval)",
        "guaranteed.*(?:approval|loan|disbursal|amount|sanction)",
        "(?:instant|immediate|5\\s*mins?|2\\s*mins?|lightning).*(?:approval|loan|disbursal|cash)",
        "pre.?approved.*(?:loan|limit|cash)",
        "assured.*(?:loan|approval)",
        "no.*(?:credit check|cibil|documents?|income proof|salary slip)",
        "everyone.*(?:eligible|approved)",
        "no.*rejection",
        "zero.*cibil.*required",
        "(?:bina cibil|100% guarantee|turant loan|10 minute me loan)",
        "(?:\\u092c\\u093f\\u0928\\u093e \\u0938\\u093f\\u092c\\u093f\\u0932|\\u0917\\u093e\\u0930\\u0902\\u091f\\u0940\\u0921 \\u0932\\u094b\\u0928|\\u0924\\u0941\\u0930\\u0902\\u0924 \\u0932\\u094b\\u0928)"
      ],
      "explanation": "RBI-registered lenders are legally required to evaluate creditworthiness and perform KYC. No genuine lender offers 100% guaranteed approval without credit assessment.",
      "recommendation": "Be extremely skeptical of guaranteed approval claims. Real lenders always review your credit profile."
    },
    {
      "id": "otp_request",
      "label": "OTP / Security Credential Request",
      "weight": 30,
      "patterns": [
        "(?:share|send|give|tell|enter|input|forward|submit|type|disclose|transfer).*(?:otp|one.?time.?password|mpin|tpin|atm pin|cvv|password|passcode)",
        "(?:verify|confirm|validate).*(?:your)?\\s*(?:otp|pin|credentials|passcode)",
        "(?:ask|request|demand).*(?:for)?\\s*(?:otp|pin|password)",
        "(?:enter|fill|type|submit).*(?:otp|pin|password|verification code).*(?:link|form|sms|url|page|below)",
        "(?:otp|pin|cvv).*(?:required|needed|mandatory|must be provided).*(?:loan|disburs|approval|claim|process|release)",
        "(?:call|contact|message).*(?:to provide|with).*(?:otp|pin)",
        "(?:otp|pin|password|mpin).*(?:batao|share karo|bhejo|de do|bata do)",
        "(?:\\u0913\\u091f\\u0940\\u092a\\u0940|\\u092a\\u093f\\u0928|\\u092a\\u093e\\u0938\\u0935\\u0930\\u094d\\u0921).*(?:\\u092c\\u0924\\u093e\\u0913|\\u0936\\u0947\\u092f\\u0930|\\u0926\\u094b|\\u092d\\u0947\\u091c\\u094b)",
        "(?:\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bbf|\\u0b93\\u0b9f\\u0bbf\\u0baa\\u0bbf).*(?:\\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc1|\\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1)",
        "(?:\\u0c13\\u0c1f\\u0c40\\u0c2a\\u0c40|\\u0c2a\\u0c3f\\u0c28\\u0c4d).*(?:\\u0c1a\\u0c46\\u0c2a\\u0c4d\\u0c2a\\u0c02\\u0c21\\u0c3f|\\u0c07\\u0c35\\u0c4d\\u0c35\\u0c02\\u0c21\\u0c3f)",
        "(?:\\u0913\\u091f\\u0940\\u092a\\u0940|\\u092a\\u093f\\u0928).*(?:\\u0938\\u093e\\u0902\\u0917\\u093e|\\u0926\\u094d\\u092f\\u093e)",
        "(?:\\u0993\\u099f\\u09bf\\u09aa\\u09bf|\\u09aa\\u09bf\\u09a8).*(?:\\u09a6\\u09bf\\u09a8|\\u09ac\\u09b2\\u09c1\\u09a8)",
        "(?:\\u0c92\\u0c9f\\u0cbf\\u0caa\\u0cbf|\\u0caa\\u0cbf\\u0ca8\\u0ccd).*(?:\\u0cb9\\u0cc7\\u0cb3\\u0cbf)"
      ],
      "explanation": "Legitimate financial institutions and loan agents will NEVER ask for your OTP, PIN, CVV, or passwords. Sharing these allows scammers to drain your accounts.",
      "recommendation": "Never share your OTP or PIN with anyone, even someone claiming to be a bank official or recovery agent."
    },
    {
      "id": "urgency_pressure",
      "label": "Urgency / High-Pressure Tactics",
      "weight": 15,
      "patterns": [
        "\\b(?:urgent|asap|immediately|right now|hurry|hurrying)\\b",
        "limited.*(?:time|offer|slots?|seats?|validity)",
        "expires?.*(?:today|soon|hours?|minutes?|now)",
        "today.*only",
        "last.*(?:chance|day|hour)",
        "act.*(?:now|immediately|fast)",
        "don.?t.*miss",
        "within.*(?:\\d+\\s*hours?|\\d+\\s*minutes?|today)"
      ],
      "explanation": "Scammers manufacture artificial urgency to force you into making hasty decisions without verifying the lender's legitimacy.",
      "recommendation": "Do not rush. Take adequate time to verify the lender's official RBI registration."
    },
    {
      "id": "fake_rbi_claim",
      "label": "Fake RBI / Government Scheme Claim",
      "weight": 30,
      "patterns": [
        "rbi.(?:approved|registered|authorized|certified|licensed|backed|verified|loan)",
        "reserve.*bank.*(?:approved|authorized|certified|scheme|loan)",
        "government.*(?:approved|scheme|loan|backed)",
        "pm.*(?:loan|yojana|scheme|mudra)",
        "pradhan mantri.*(?:loan|yojana)",
        "rbi.*(?:loan|scheme|offer|subsidy)"
      ],
      "explanation": "The Reserve Bank of India (RBI) is a regulatory body. RBI DOES NOT lend money directly to individuals, operate loan apps, or guarantee loans.",
      "recommendation": "Any loan message claiming to be directly from RBI or PM Yojana with non-government links is fraudulent."
    },
    {
      "id": "recovery_threat",
      "label": "Illegal Recovery / Harassment Threats",
      "weight": 35,
      "patterns": [
        "contact.*(?:family|relatives|friends|employer|boss|colleagues|contacts)",
        "share.*(?:photos?|images?|videos?).*(?:contacts?|family|friends|whatsapp|social media)",
        "legal.*action.*(?:if|unless|failure|within)",
        "police.*(?:case|complaint|action|station|fir)",
        "arrest.*(?:warrant|order|notice)",
        "morphed.*(?:photos?|images?|nude)",
        "send.*(?:photos?|images?).*(?:contacts?|whatsapp)",
        "embarrass.*(?:you|family|employer|publicly)",
        "court.*notice.*(?:today|within)",
        "send.*recovery.*agents?.*(?:home|house|office)"
      ],
      "explanation": "Threatening borrowers, contacting their friends/family, or accessing photo galleries for extortion violates RBI's Fair Practices Code and is a criminal offense.",
      "recommendation": "File an immediate complaint on cybercrime.gov.in and dial 1930. Block harassment numbers."
    },
    {
      "id": "hidden_charges",
      "label": "Hidden Charges & Unclear Terms",
      "weight": 12,
      "patterns": [
        "hidden.*(?:charges?|fees?|costs?)",
        "additional.*(?:charges?|fees?|costs?).*apply",
        "extra.*(?:charges?|fees?|interest)",
        "processing.*(?:fees?|charges?).*(?:deducted|will be|automatically|cut)",
        "gst.*(?:extra|additional|separate)",
        "service.*tax.*(?:extra|additional)",
        "late.*penalty.*(?:daily|every day|per day)"
      ],
      "explanation": "Predatory loan apps conceal high deductions, daily penalties, and non-transparent processing fees, often leaving the borrower with only a fraction of the sanctioned loan.",
      "recommendation": "Demand a Key Fact Statement (KFS) stating the All-Inclusive Annual Percentage Rate (APR) before signing."
    },
    {
      "id": "unfair_clauses",
      "label": "Unfair Contract / Predatory T&C Clauses",
      "weight": 20,
      "patterns": [
        "modify.*(?:terms|interest|fees?).*(?:without notice|sole discretion|unilateral)",
        "waive.*(?:right|court|legal remedy|dispute)",
        "binding.*arbitration.*(?:solely|exclusive jurisdiction outside india)",
        "auto.?debit.*without.*(?:prior notice|consent|authorization)",
        "perpetual.*irrevocable.*(?:license|consent|authorization)",
        "indemnify.*against.*all.*claims"
      ],
      "explanation": "Unfair contract terms allowing the lender to unilaterally alter interest rates or waive your rights to approach consumer/civil courts violate consumer protection norms.",
      "recommendation": "Never accept agreements with unilateral revision clauses or waivers of statutory rights."
    },
    {
      "id": "suspicious_privacy",
      "label": "Suspicious Privacy & Data Sharing Terms",
      "weight": 22,
      "patterns": [
        "share.*data.*(?:third party|recovery agents?|partners?|affiliates?).*without.*consent",
        "sell.*(?:personal information|data|contacts|browsing)",
        "collect.*(?:all files|media|photos|call history|sms logs)",
        "transfer.*data.*outside.*india",
        "retain.*data.*indefinitely",
        "unrestricted.*access.*to.*device"
      ],
      "explanation": "RBI Digital Lending Guidelines strictly prohibit lending apps from accessing mobile phone resources like file systems, contact lists, call logs, and telephony data.",
      "recommendation": "Review privacy policies carefully. Refuse apps that share your data with unauthorized third parties."
    },
    {
      "id": "suspicious_link",
      "label": "Suspicious / Unverified Links",
      "weight": 15,
      "patterns": [
        "bit\\.ly",
        "tinyurl",
        "shorturl",
        "t\\.co",
        "is\\.gd",
        "click.*here.*(?:now|immediately|to apply|to claim)",
        "tap.*here.*(?:to apply|to get|for loan|to unlock)",
        "download.*(?:apk|app).*(?:from|at|via).*(?:link|below|drive)",
        "http[s]?://(?!.*\\.(?:gov\\.in|nic\\.in|bank)).*(?:loan|cash|rupee|credit|instant|paisa).*(?:\\.xyz|\\.top|\\.click|\\.club|\\.site|\\.online|\\.link|\\.app)",
        "install.*(?:from|via).*link"
      ],
      "explanation": "Shortened URLs and direct APK links bypass Google Play Protect and often distribute malicious spyware designed to steal personal data.",
      "recommendation": "Never download loan apps from direct links, APK files, or SMS. Install only from official app stores."
    },
    {
      "id": "excessive_data_collection",
      "label": "Excessive App Permission Demands",
      "weight": 20,
      "patterns": [
        "access.*(?:contacts|call logs?|gallery|photos|camera|microphone|location|sms|storage)",
        "permission.*(?:contacts|call logs?|gallery|photos|camera|sms|media)",
        "allow.*access.*(?:contacts|messages|photos|storage|files|phone state)",
        "read.*(?:contacts|call history|sms inbox|device storage)",
        "mandatory.*permission.*(?:contacts|gallery|photos)"
      ],
      "explanation": "A digital lending app only needs basic identity and bank verification. Demanding access to contacts, photos, or call logs is a prime indicator of an illegal predatory app.",
      "recommendation": "Deny contact, media, and call log permissions. If the app refuses to work without them, uninstall immediately."
    },
    {
      "id": "recovery_agent_extortion",
      "label": "Call Extortion & Defamation Threats",
      "weight": 35,
      "patterns": [
        "call.*(?:all)?.*(?:contacts|family|relatives|parents|father|mother|boss|office|friends)",
        "send.*(?:photos|video|morphed).*(?:contacts|whatsapp|relatives|social media)",
        "shame.*(?:you|family|relatives|society|neighborhood)",
        "ruin.*(?:reputation|career|family|life)",
        "send.*(?:boys|goons|men|recovery team|agents).*(?:home|house|flat|address|office|village)",
        "gherao|dharna|tamasha.*(?:home|house|office)",
        "beat.*up|break.*legs|see.*you.*personally",
        "post.*(?:photo|picture|fraud|chor|defaulter).*(?:facebook|instagram|whatsapp group|status)",
        "(?:ladke|gunde|agents?).*(?:bhej dunga|bhejenge|bhej rahe|aayenge)",
        "ghar.*(?:aake|pe).*(?:tamasha|gherao|dharna|hungama)",
        "(?:contacts|relatives|family|rishtedaaron|doston).*(?:ko photo|ko call|ko batayenge)",
        "(?:morphed|gandi).*(?:photo|video|picture).*(?:viral|whatsapp|facebook)",
        "badnaam.*karenge|ijjat.*kharab|tamasha.*society",
        "(?:\\u0918\\u0930 \\u092a\\u0930 \\u0932\\u0921\\u093c\\u0915\\u0947|\\u0917\\u0941\\u0902\\u0921\\u0947|\\u092b\\u094b\\u091f\\u094b \\u0935\\u093e\\u092f\\u0930\\u0932|\\u092c\\u0926\\u0928\\u093e\\u092e \\u0915\\u0930\\u0947\\u0902\\u0917\\u0947)",
        "(?:\\u0bae\\u0bbf\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd|\\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bcb \\u0bb5\\u0bc8\\u0bb0\\u0bb2\\u0bcd|\\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bcb\\u0ba9\\u0bcd)",
        "(?:\\u0c2b\\u0c4b\\u0c1f\\u0c4b\\u0c32\\u0c41 \\u0c35\\u0c48\\u0c30\\u0c32\\u0c4d|\\u0c2c\\u0c02\\u0c27\\u0c41\\u0c35\\u0c41\\u0c32\\u0c15\\u0c41 \\u0c15\\u0c3e\\u0c32\\u0c4d|\\u0c07\\u0c02\\u0c1f\\u0c3f\\u0c15\\u0c3f \\u0c35\\u0c38\\u0c4d\\u0c24\\u0c3e\\u0c02)",
        "(?:\\u0918\\u0930\\u0940 \\u0917\\u0941\\u0902\\u0921 \\u092a\\u093e\\u0920\\u0935\\u0942|\\u092b\\u094b\\u091f\\u094b \\u0935\\u094d\\u0939\\u093e\\u092f\\u0930\\u0932 \\u0915\\u0930\\u0942|\\u0928\\u093e\\u0924\\u0947\\u0935\\u093e\\u0908\\u0915\\u093e\\u0902\\u0928\\u093e \\u092b\\u094b\\u0928)",
        "(?:\\u099b\\u09ac\\u09bf \\u09ad\\u09be\\u0987\\u09b0\\u09be\\u09b2 \\u0995\\u09b0\\u09ac|\\u09ac\\u09be\\u09a1\\u09bc\\u09bf\\u09a4\\u09c7 \\u09b2\\u09cb\\u0995 \\u09aa\\u09be\\u09a0\\u09be\\u09ac)",
        "(?:\\u0cab\\u0ccb\\u0c9f\\u0ccb \\u0cb5\\u0cc8\\u0cb0\\u0cb2\\u0ccd|\\u0cae\\u0ca8\\u0cc6\\u0c97\\u0cc6 \\u0cac\\u0cb0\\u0cc1\\u0ca4\\u0ccd\\u0ca4\\u0cc7\\u0cb5\\u0cc6)"
      ],
      "explanation": "RBI's circular on Recovery Agents (DOR.ORG.REC.65/21.04.158/2022-23) strictly prohibits any threats of violence, intimidation, or public shaming/defamation. Contacting borrowers' family or friends is a punishable criminal violation.",
      "recommendation": "Preserve this call recording as evidence. Immediately lodge an FIR with local police and submit an extortion complaint at cybercrime.gov.in."
    },
    {
      "id": "fake_law_enforcement",
      "label": "Law Enforcement & Court Impersonation",
      "weight": 30,
      "patterns": [
        "calling\\s+from\\s+(?:the\\s+)?(?:police|crime branch|cbi|ed|cyber cell|high court|supreme court|rbi vigilance)",
        "police.*(?:fir|arrest warrant|non-bailable|nbw|custody|lockup)",
        "court.*(?:order|warrant|summons|action|case filed)",
        "police.*team.*(?:on the way|coming to your house|dispatched)",
        "surrender.*(?:police station|court)",
        "section.*420|cheating case.*police",
        "(?:police station se bol raha|crime branch se|cbi team|court ka warrant|420 ka case)",
        "(?:\\u092a\\u0941\\u0932\\u093f\\u0938 \\u0938\\u094d\\u091f\\u0947\\u0936\\u0928 \\u0938\\u0947|\\u0915\\u094d\\u0930\\u093e\\u0907\\u092e \\u092c\\u094d\\u0930\\u093e\\u0902\\u091a|\\u0917\\u0948\\u0930-\\u091c\\u092e\\u093e\\u0928\\u0924\\u0940 \\u0935\\u093e\\u0930\\u0902\\u091f|\\u0927\\u093e\\u0930\\u093e 420)",
        "(?:\\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bae\\u0bcd|\\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0ba4\\u0bbf\\u0bb5\\u0bc1)",
        "(?:\\u0c2a\\u0c4b\\u0c32\\u0c40\\u0c38\\u0c4d \\u0c38\\u0c4d\\u0c1f\\u0c47\\u0c37\\u0c28\\u0c4d|\\u0c35\\u0c3e\\u0c30\\u0c46\\u0c02\\u0c1f\\u0c4d \\u0c1c\\u0c3e\\u0c30\\u0c40)",
        "(?:\\u092a\\u094b\\u0932\\u0940\\u0938 \\u0920\\u093e\\u0923\\u094d\\u092f\\u093e\\u0924\\u0942\\u0928|\\u0935\\u0949\\u0930\\u0902\\u091f \\u091c\\u093e\\u0930\\u0940)"
      ],
      "explanation": "Scammers and illegal recovery agents routinely impersonate police officers, CBI agents, or court bailiffs over the phone. Civil loan defaults are not criminal offenses and police cannot arrest without due judicial process.",
      "recommendation": "Do not panic. Demand the caller's official designation, police station name, and official landline. Verify directly with your local police station."
    },
    {
      "id": "telecaller_upfront_fee",
      "label": "Phone Demand for Instant UPI / Advance Payment",
      "weight": 25,
      "patterns": [
        "(?:pay|transfer|send).*(?:via|on|through).*(?:gpay|google pay|phonepe|paytm|upi|qr code)",
        "(?:send|transfer).*(?:money|amount|fee).*(?:now|immediately|on call|while on phone)",
        "share.*(?:screenshot|utr|reference number).*(?:on whatsapp|immediately)",
        "processing.*fee.*(?:paytm|phonepe|gpay|upi)",
        "gst.*amount.*transfer.*immediately",
        "(?:gpay|phonepe|paytm|upi).*(?:pe bhejo|pe transfer karo|daalo|number pe send karo)",
        "(?:\\u0917\\u0942\\u0917\\u0932 \\u092a\\u0947|\\u092b\\u094b\\u0928\\u092a\\u0947|\\u092a\\u0947\\u091f\\u0940\\u090f\\u092e|\\u092f\\u0942\\u092a\\u0940\\u0906\\u0908).*(?:\\u092a\\u0930 \\u092d\\u0947\\u091c\\u094b|\\u092a\\u0930 \\u091f\\u094d\\u0930\\u093e\\u0902\\u0938\\u092b\\u0930)",
        "(?:\\u0b95\\u0bc2\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0baa\\u0bc7|\\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0baa\\u0bc7|\\u0baf\\u0bc2\\u0baa\\u0bbf\\u0b90).*(?:\\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1)",
        "(?:\\u0c17\\u0c42\\u0c17\\u0c41\\u0c32\\u0c4d \\u0c2a\\u0c47|\\u0c2b\\u0c4b\\u0c28\\u0c4d\\u200c\\u0c2a\\u0c47|\\u0c2f\\u0c42\\u0c2a\\u0c40\\u0c10).*(?:\\u0c2a\\u0c02\\u0c2a\\u0c02\\u0c21\\u0c3f)"
      ],
